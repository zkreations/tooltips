{
  "name": "@zkreations/tooltips",
  "version": "5.0.0",
  "description": "Tiny and powerful tooltips with pure CSS",
  "files": [
    "index.css",
    "index.min.css",
    "scss/**/*.scss"
  ],
  "style": "index.min.css",
  "sass": "scss/tooltip.scss",
  "exports": {
    ".": {
      "style": "./index.min.css",
      "default": "./index.min.css",
      "sass": "./scss/tooltip.scss"
    },
    "./index.css": "./index.css",
    "./index.min.css": "./index.min.css",
    "./scss/*": "./scss/*"
  },
  "scripts": {
    "start": "pnpm --parallel watch:css serve",
    "compile": "pnpm run compile:css && pnpm run minify:css",
    "compile:css": "sass --style expanded --no-source-map scss/tooltip.scss:index.css",
    "minify:css": "lightningcss --minify --bundle --targets \">= 0.25%\" index.css -o index.min.css",
    "watch:css": "sass --watch scss/tooltip.scss:index.css --style expanded --no-source-map",
    "lint:css": "stylelint scss/**/*.scss --config .stylelintrc.json",
    "lint:css:fix": "stylelint scss/**/*.scss --config .stylelintrc.json --fix",
    "serve": "servor ./ --reload --browse"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkreations/tooltips.git"
  },
  "keywords": [
    "css",
    "tooltips",
    "nojs",
    "pure-css",
    "ui",
    "frontend"
  ],
  "author": "Abel Moreira Moreno",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zkreations/tooltips/issues"
  },
  "homepage": "https://github.com/zkreations/tooltips#readme",
  "devDependencies": {
    "lightningcss-cli": "^1.33.0",
    "sass": "^1.104.0",
    "servor": "^4.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
